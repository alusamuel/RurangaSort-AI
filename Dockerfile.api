FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY api ./api
COPY worker ./worker
COPY scripts ./scripts
COPY models ./models
COPY data/raw ./data/raw

# Regenerate data/train|validation|test + data/processed/manifest.json at
# *build* time (not runtime) so /dataset-summary and /evaluate work out of
# the box on a fresh deploy -- Render's free tier has no shell access to run
# this after the fact, and doing it on every container boot would slow down
# every cold start for no reason since data/raw/ is static once built in.
RUN python scripts/prepare_data.py

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

# Shell form (not exec-form JSON) so ${PORT} is expanded -- PaaS hosts like
# Render assign a dynamic port via $PORT and require the process to listen on
# it; docker-compose/local runs won't set it, so it falls back to 8000.
CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}

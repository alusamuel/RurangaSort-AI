.env
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# data/raw/ IS committed on purpose (~47MB, real TrashNet resized images) --
# Dockerfile.api COPYs it in and runs scripts/prepare_data.py at *build* time
# to regenerate data/train|validation|test + data/processed/manifest.json
# inside the image, so /dataset-summary and /evaluate work on a fresh deploy
# without needing shell access on the host (not available on Render's free
# tier) or a runtime preprocessing step that would slow down every cold start.
# The derived splits themselves stay untracked -- pure build output, would
# just triple the repo size for no benefit since the Dockerfile regenerates
# them deterministically from data/raw/ every build.
data/processed/**
data/train/**
data/validation/**
data/test/**
data/uploaded/**
!data/processed/.gitkeep
!data/train/.gitkeep
!data/validation/.gitkeep
!data/test/.gitkeep
!data/uploaded/.gitkeep

models/candidate/*
models/archived/*
models/class_names.json
!models/candidate/.gitkeep
!models/archived/.gitkeep
# models/active/ IS committed on purpose: it's the currently-promoted model
# (model.h5 + metadata, ~21MB), shipped with the repo so a fresh clone/cloud
# deploy has a working model out of the box instead of a 503 until someone
# retrains. models/candidate/ and models/archived/ stay untracked -- those
# are transient working state, not a deployable artifact.

reports/figures/*
reports/evaluation/*
reports/production_evaluation/*
reports/load_tests/*
!reports/**/.gitkeep

.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

rurangasort.db
*.log

.claude/

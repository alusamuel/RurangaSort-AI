APP_NAME=RurangaSort AI
ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000

# Shared secret required in the X-API-Key header for /upload-data and /retrain
API_KEY=change-me-local-dev-key

MODEL_DIR=models
MODEL_PATH=models/active/model.h5
CLASS_NAMES_PATH=models/class_names.json

IMAGE_SIZE=224
NUM_CHANNELS=3

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./rurangasort.db

DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_TRAIN_DIR=data/train
DATA_VALIDATION_DIR=data/validation
DATA_TEST_DIR=data/test
UPLOAD_DIRECTORY=data/uploaded

MAX_UPLOAD_SIZE_MB=200
MAX_ZIP_FILES=5000

# Model promotion thresholds
PROMOTION_MIN_MACRO_F1_DELTA=-0.01
PROMOTION_MAX_LATENCY_MS=500
PROMOTION_MAX_PER_CLASS_RECALL_DROP=0.05

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
